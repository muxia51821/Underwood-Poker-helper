{
  "schema": "solver-lab-fixtures-v1",
  "limits": {"iterations": 100000, "seconds": 300},
  "tolerances": {"nashConvPotFraction": 0.0001, "evBb": 0.001, "mixFraction": 0.005},
  "cases": [
    {"id":"river-half-pot", "board":["Ks","7d","2c","8h","3d"], "ranges":["KK,A4s,A5s","TT,JJ"], "potBb":10, "stackBb":20, "betBb":5, "rake":0, "icm":false},
    {"id":"river-pot", "board":["Ks","7d","2c","8h","3d"], "ranges":["KK,A4s,A5s","TT,JJ"], "potBb":10, "stackBb":20, "betBb":10, "rake":0, "icm":false}
  ],
  "tree": {"root":["check","bet:{betBb}"], "root/check":["check"], "root/bet:{betBb}":["fold","call"]},
  "evConvention": "bb; net utility from solve start, allocating half of initial pot to each player; average-strategy continuation"
}
